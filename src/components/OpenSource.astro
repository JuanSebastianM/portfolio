---
import { openSource } from '../data/projects';
---

<section class="shell section" id="open-source">
  <header class="section-head">
    <p class="kicker">Pull requests</p>
    <h2>Open source contributions</h2>
  </header>
  <ul class="oss-list">
    {
      openSource.map((item) => (
        <li class="card card-pad">
          <p class="flag">{item.kind}</p>
          <h3>{item.name}</h3>
          {item.detail && <p class="role-copy">{item.detail}</p>}
          <ul class="role-points">
            {item.actions.map((action) => (
              <li>
                <a href={action.href} target="_blank" rel="noreferrer">{action.text}</a>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</section>
