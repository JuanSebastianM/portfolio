---
import { render } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import { identity, siteUrl } from '../../data/site';
import { formatDate, getPosts, tagHref } from '../../lib/posts';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.data.slug } }));
}

const { slug } = Astro.params;
const posts = await getPosts();
const post = posts.find((item) => item.data.slug === slug);
if (!post) {
  throw new Error(`Missing post for slug ${slug}`);
}

const { Content } = await render(post);
const related = posts
  .filter((item) => item.data.slug !== post.data.slug && item.category.slug === post.category.slug)
  .slice(0, 2);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: identity.name,
      url: siteUrl,
      jobTitle: identity.role,
    },
    {
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.excerpt,
      datePublished: post.data.date.toISOString(),
      author: { '@type': 'Person', name: identity.name, url: siteUrl },
      image: post.data.coverImage ? new URL(post.data.coverImage, siteUrl).toString() : undefined,
      keywords: post.data.tags.join(', '),
      mainEntityOfPage: new URL(`/blog/${post.data.slug}`, siteUrl).toString(),
      inLanguage: 'en',
    },
  ],
};
---

<Base
  title={post.data.title}
  description={post.excerpt}
  image={post.data.coverImage}
  type="article"
  published={post.data.date}
  tags={post.data.tags}
  showProgress
  jsonLd={jsonLd}
>
  <article class="shell section" style="padding-bottom: 2rem;">
    <header class="section-head">
      <p class="kicker">
        <a href={`/blog/category/${post.category.slug}`} style="color: inherit; text-decoration: none;">
          {post.category.name}
        </a>
      </p>
      <h1 style="font-size: clamp(2.3rem, 5vw, 4.2rem);">{post.data.title}</h1>
      {post.data.subtitle && <p class="lede" style="margin-top: 0.8rem;">{post.data.subtitle}</p>}
      <div class="meta-row" style="margin-top: 1rem;">
        <time class="chip" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span class="chip">{post.minutes} min read</span>
      </div>
      <div class="meta-row" style="margin-top: 0.55rem;">
        {post.data.tags.map((tag) => <a class="tag" href={tagHref(tag)}>#{tag}</a>)}
      </div>
    </header>
    {
      post.data.coverImage && (
        <figure class="cover-frame">
          <img src={post.data.coverImage} alt="" />
        </figure>
      )
    }
    <div class="post-body prose">
      <Content />
    </div>
  </article>
  {
    related.length > 0 && (
      <section class="shell section" style="padding-top: 0;">
        <header class="section-head">
          <p class="kicker">Same category</p>
          <h2>Keep reading</h2>
        </header>
        <ul class="post-grid" style="margin-top: 1rem;">
          {related.map((item) => (
            <li>
              <PostCard post={item} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
