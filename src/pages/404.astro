---
import { identity } from '../data/site';
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description={`That page is not on ${identity.name}'s site.`}>
  <section class="shell section">
    <p class="kicker">Offside</p>
    <h1 style="font-size: clamp(3rem, 8vw, 5.5rem);">404</h1>
    <p class="lede">That page is not on the pitch.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">Back home</a>
      <a class="btn btn-ghost" href="/blog">Read the blog</a>
    </div>
  </section>
</Base>
